# Mattermost embedding is opt-in; enable only on a trusted private network.
MATTERMOST_ENABLED=false
MATTERMOST_EMBED_ENABLED=false
MATTERMOST_BASE_URL=
MATTERMOST_TOKEN=
MATTERMOST_TEAM=
MATTERMOST_ALLOWED_CHANNEL_KINDS=operations
MATTERMOST_SYNC_DIRECTION=outbound
MATTERMOST_CREATE_CHANNELS=false
# Inbound mirroring stores text posts from one explicitly mapped channel in the ITMS Mattermost history feed.
MATTERMOST_INBOUND_ENABLED=false
MATTERMOST_INBOUND_WEBHOOK_TOKEN=
MATTERMOST_INBOUND_CHANNEL_ID=
# AI assistant (optional). Without these values, ITMS uses built-in operational guidance.
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_TIMEOUT=20s
# Google OAuth (optional) - leave empty to disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# GOOGLE_HOSTED_DOMAIN: Restrict authentication to specific email domain (e.g., company.com).
# Leave empty to allow any domain. This applies to both password and Google SSO login.
GOOGLE_HOSTED_DOMAIN=
